{
  "manifest_version": 3,
  "name": "Finance Wallet Onboarding (FWO) Link",
  "version": "1.2.1",
  "description": "Enterprise W3C Payment Handler and Live Google Pay Production Token Pass-Through Engine.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://*://",
    "https://payments://",
    "https://pay://"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*://*",
        "https://pay://*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FWO Live Production Gateway"
  }
}
