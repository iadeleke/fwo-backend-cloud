{
  "manifest_version": 3,
  "name": "Finance Wallet Onboarding (FWO) Link",
  "version": "1.1.5",
  "description": "Multi-node cryptographic receipt orchestration and automated cloud checkout engine.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FWO Orchestration Core"
  }
}
